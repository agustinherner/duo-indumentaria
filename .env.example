# ===== Base de datos (PostgreSQL) =====
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BASE?schema=public
# En local, con la base creada según el README. En producción, la URL que te dé el
# proveedor (Railway, Neon, etc.), normalmente con ?sslmode=require al final.
DATABASE_URL="postgresql://duo:CAMBIAR_CLAVE@localhost:5432/duo_indumentaria?schema=public"

# ===== Sesión / seguridad =====
# Clave secreta para firmar los tokens de sesión. OBLIGATORIA: sin ella la tienda no arranca.
# Generá una larga y aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# URL pública del sitio (se usa en los links de verificación de mail)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== Envío de mails (verificación + newsletter) =====
# Datos de tu proveedor SMTP (Gmail, Zoho, Brevo, etc.)
# Si dejás esto vacío, los mails se muestran en la consola del servidor (modo desarrollo).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Duo Indumentaria <no-reply@duoindumentaria.com>"

# ===== Mercado Pago =====
# Obtené tus credenciales en https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# ===== Admin inicial (se crea con el seed) =====
# Elegí una contraseña propia (mínimo 8 caracteres). Si la cambiás, corré "npm run db:seed"
# para actualizarla en la base.
ADMIN_EMAIL="admin@duoindumentaria.com"
ADMIN_PASSWORD=""
